{
    "name": "mustafa/yemek-kurye-takip",
    "description": "PHP 8.2+ Yemek Sipariş ve Kurye Takip Sistemi (State Deseni, Kurye Puanlama ve Katmanlı Mimari)",
    "type": "project",
    "require": {
        "php": ">=8.2"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "seed": "php bin/seed.php"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0"
    }
}
